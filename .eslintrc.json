{
  "ignorePatterns": [
    "projects/**/*"
  ],
  "overrides": [
    {
      "env": {
        "browser": true,
        "es6": true,
        "node": true
      },
      "extends": [
        // "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
      ],
      "files": [
        "*.ts"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": 2020, // Or higher, e.g., 2022 for private class fields
        "ecmaFeatures": {
          "decorators": true,
          "jsx": true
        },
        "project": "src/tsconfig.json",
        "sourceType": "module"
      },
      "plugins": [
        "@typescript-eslint",
        "@angular-eslint"
      ],
      "rules": {
        "@angular-eslint/component-selector": [
          "error",
          {
            "prefix": "app",
            "style": "kebab-case",
            "type": "element"
          }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          {
            "prefix": "app",
            "style": "camelCase",
            "type": "attribute"
          }
        ],
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-inferrable-types": [
          "error",
          {
            "ignoreParameters": true
          }
        ],
        "@typescript-eslint/no-unused-vars": [
          "warn",
          {
            "argsIgnorePattern": "^_"
          }
        ],
        "max-len": [
          "warn",
          {
            "code": 140
          }
        ],
        "no-console": [
          "warn",
          {
            "allow": [
              "warn",
              "error"
            ]
          }
        ],
        "no-undef": "off",
        "no-unused-vars": "off",
        "no-useless-escape": "warn",
        "quotes": [
          "error",
          "single"
        ]
      }
    },
    {
      "env": {
        "jasmine": true
      },
      "files": [
        "*.spec.ts"
      ],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": [
        "*.html"
      ],
      "parser": "@angular-eslint/template-parser",
      "plugins": [
        "@angular-eslint/template"
      ],
      "rules": {}
    }
  ],
  "root": true
}